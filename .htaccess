# siPaw — web root hardening (safe to keep in git)
DirectoryIndex index.php index.html

# Block git metadata if the clone lives in the web root
RedirectMatch 404 /\.git

<IfModule mod_authz_core.c>
  <FilesMatch "^(config\.php|config\.local\.php|config\.example\.php)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>

# Deny PHP in uploads (belt + suspenders; also see uploads/pets/.htaccess)
# Block HTTP access to in-docroot config/ (secrets must not be downloadable)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^uploads/.*\.(?i:php|phtml|phar)$ - [F,L]
  RewriteRule ^config(/|$) - [F,L]
  # Pretty blog URLs → PHP handlers
  RewriteRule ^blog/?$ blog.php [L,QSA]
  RewriteRule ^blog/([a-z0-9\-]+)/?$ blog-post.php?slug=$1 [L,QSA]
  # Clean URLs: /dashboard → dashboard.php (top-level pages only; real files and folders win)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([a-z0-9\-]+)/?$ $1.php [L,QSA]
</IfModule>

# Speed: compress text responses (pages, CSS, JS, JSON, SVG)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
