# RingRingPaw — Hostinger / Apache rules for ringringpaw.nakilab.com
# Keep this file in the subdomain document root alongside index.html.

# Hide VCS and non-public files from the web
RedirectMatch 404 /\.git
RedirectMatch 404 /\.claude

<FilesMatch "\.(md|sql|sqlite|env|json)$">
  Require all denied
</FilesMatch>

# Prefer HTTPS (Hostinger usually terminates TLS already; this covers stray http)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Sensible caching for static assets; HTML stays fresh
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Prototype: do not encourage search indexing of the demo auth flow
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
